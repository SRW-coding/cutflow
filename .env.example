# ============================================================
# CutFlow Frontend — Environment Variables
#
# DEPLOYMENT (Vercel):
#   Set VITE_CUTFLOW_API_BASE_URL in your Vercel project's
#   Environment Variables (Settings → Environment Variables).
#   Use the Render backend URL + /v1.
#   Example: https://cutflow-api.onrender.com/v1
#
# LOCAL:
#   Copy to .env and start the backend on port 3000.
# ============================================================

# Show floating debug panel in the editor (dev only)
VITE_SHOW_DEBUG_PANEL=true

# CutFlow NestJS API base URL (must include /v1 version prefix)
# Local:      http://localhost:3000/v1
# Production: https://your-render-slug.onrender.com/v1
VITE_CUTFLOW_API_BASE_URL=http://localhost:3000/v1

VITE_LANDING_REDIRECT_TO=false
VITE_ENABLE_TRANSCRIPTION=false
