# ===========================================
# Frontend Configuration (Vite)
# ===========================================

# Show/hide floating debug button in editor (dev mode only)
# Set to 'false' to hide debug panel button during development
VITE_SHOW_DEBUG_PANEL=true

# Cutflow Laravel API (b-roll library: GET /brolls/library)
# Example: http://127.0.0.1:8000/api
VITE_CUTFLOW_API_BASE_URL=
VITE_LANDING_REDIRECT_TO=false
VITE_ENABLE_TRANSCRIPTION=false